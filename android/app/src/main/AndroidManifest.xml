<?xml version="1.0" encoding="utf-8"?>
<!-- Javier Villalón Mena - UOC PR2. Permisos: SCHEDULE_EXACT_ALARM, GPS, CAMERA(flash).
     Canal notificacions: dropappalerts (importance 5). Icona: ic_stat_dropapp.
     Soluciona restriccions Android 13+ i MIUI. FIX 22/01/2026: tools:node compatibilitat. -->
     
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 'xmlns:tools' és necessari per utilitzar 'tools:replace' i gestionar conflictes de llibreries -->

    <!-- ============================================================ -->
    <!-- 1. PERMISOS DE CONNECTIVITAT I DADES                         -->
    <!-- ============================================================ -->

    <!-- API: Necessari per connectar a Open-Meteo i obtenir dades climàtiques (Temp/Humitat) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- GEOLOCALITZACIÓ: Per contextualitzar la dada climàtica a la zona de l'usuari -->
    <!-- ACCESS_COARSE_LOCATION: Ubicació aproximada (més ràpida, menys bateria) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_FINE_LOCATION: Ubicació precisa (necessària per a APIs meteorològiques locals) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    
    <!-- Feature GPS: Indiquem que l'app usa GPS, però no és obligatori (pot funcionar amb IP) -->
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- ============================================================ -->
    <!-- 2. PERMISOS DE FEEDBACK (INTERFÍCIE FÍSICA)                  -->
    <!-- ============================================================ -->

    <!-- FEEDBACK VISUAL: Permisos per controlar el LED/Flash de la càmera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FLASHLIGHT" />
    <!-- Feature Camera: Indiquem que no necessitem la càmera per fer fotos, només el llum -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- FEEDBACK HÀPTIC: Per fer vibrar el dispositiu quan s'acaba el temps -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ============================================================ -->
    <!-- 3. GESTIÓ AVANÇADA DE NOTIFICACIONS I TEMPS                  -->
    <!-- ============================================================ -->

    <!-- POST_NOTIFICATIONS: Obligatori a partir d'Android 13 per mostrar qualsevol avís -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- SCHEDULE_EXACT_ALARM: Permet programar l'avís al minut exacte. 
         Sense això, Android (mode Doze) podria endarrerir l'avís fins a 10 minuts per estalviar bateria. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    
    <!-- USE_EXACT_ALARM: Necessari específicament per a Android 14+ per garantir precisió -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- WAKE_LOCK: Permet que l'app mantingui la CPU desperta momentàniament per processar l'alarma -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- RECEIVE_BOOT_COMPLETED: Permet reactivar les alarmes si l'usuari reinicia el mòbil -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ============================================================ -->
    <!-- 4. CONFIGURACIÓ DE L'APLICACIÓ                               -->
    <!-- ============================================================ -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- CONFIGURACIÓ ICONA DE NOTIFICACIÓ PERSONALITZADA -->
        <!-- Això assegura que si el plugin no especifica icona, o el sistema la busca per defecte,
             faci servir la nostra silueta (xeringa/ull) en lloc del quadrat blanc. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_dropapp" />

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 
           RECEPTOR DE NOTIFICACIONS (BUG FIX CAPACITOR):
           El plugin LocalNotifications defineix aquest receiver com a exported="false" per defecte.
           Això provoca que en Android 12+ les notificacions fallin al reiniciar el mòbil.
           Forcem exported="true" amb 'tools:replace' per solucionar-ho.
           FIX 22/01/2026: tools:node="replace" per evitar duplicats Android Studio.
        -->
        <receiver 
            android:name="com.capacitorjs.plugins.localnotifications.LocalNotificationRestoreReceiver" 
            android:exported="true"
            tools:node="replace">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
